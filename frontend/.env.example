# Entra External ID Configuration
# Get these from Azure Portal > Entra External ID > App registrations

# Tenant domain (without .onmicrosoft.com)
VITE_AZURE_AD_TENANT_DOMAIN=engramai

# Full tenant ID (e.g., engramai.onmicrosoft.com or the GUID)
VITE_AZURE_AD_TENANT_ID=engramai.onmicrosoft.com

# Application (client) ID from app registration
VITE_AZURE_AD_CLIENT_ID=

# Redirect URI (defaults to current origin)
VITE_REDIRECT_URI=http://localhost:5173

# API Base URL
VITE_API_URL=http://localhost:8000/api/v1
