# Engram Azure Production Environment
# =====================================
# Use this file to connect to Azure Container Apps services
# Usage: source .env.azure  OR  use --env azure flag
#
# ⚠️  This connects to PRODUCTION memory - use responsibly!

# Environment
ENVIRONMENT=production
DEBUG=false

# Memory Service (Zep) - Azure Container Apps
ZEP_API_URL=https://zep.engram.work
# ZEP_API_KEY is in Azure Key Vault, not needed for external queries

# These are READ-ONLY from local machine (no direct DB access)
# Database connection is only available within Azure VNet

# Auth (production setting, but Zep currently allows anonymous reads)
AUTH_REQUIRED=false
