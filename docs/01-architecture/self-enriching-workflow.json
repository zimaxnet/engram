            "position": {
                "x": 200,
                "y": 400
            },
            "description": "Document ingested into Zep Memory (Vector + Knowledge Graph)",
            "style": {
                "backgroundColor": "#06B6D4",
                "borderColor": "#22D3EE"
            }
        },
        {
            "id": "memory",
