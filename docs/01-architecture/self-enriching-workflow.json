{
    "title": "Self-Enriching Workflow (Recursive Engineering)",
    "subtitle": "Continuous Intelligence Upgrade Loop",
    "version": "1.0",
    "theme": "dark",
    "layout": "circular",
    "nodes": [
        {
            "id": "trigger_issue",
            "label": "Issue / Task",
            "type": "event",
            "icon": "alert-circle",
            "position": {
                "x": 400,
                "y": 100
            },
            "description": "User reports a bug or requests a feature (e.g., 'VoiceLive connection failed')",
            "style": {
                "backgroundColor": "#EF4444",
                "borderColor": "#F87171"
            }
        },
        {
            "id": "agent",
            "label": "Agent (Antigravity)",
            "type": "agent",
            "icon": "bot",
            "position": {
                "x": 600,
                "y": 250
            },
            "description": "The AI engineer investigating, debugging, and resolving the issue",
            "style": {
                "backgroundColor": "#8B5CF6",
                "borderColor": "#A78BFA"
            }
        },
        {
            "id": "resolve",
            "label": "1. RESOLVE",
            "type": "action",
            "icon": "check-circle",
            "position": {
                "x": 600,
                "y": 400
            },
            "description": "Fix applied to code/infrastructure (e.g., Updated config.py)",
            "style": {
                "backgroundColor": "#10B981",
                "borderColor": "#34D399"
            }
        },
        {
            "id": "codify",
