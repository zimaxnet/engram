            "type": "action",
            "icon": "file-text",
            "position": {
                "x": 400,
                "y": 550
            },
            "description": "Knowledge captured in persistent documentation (Source of Truth)",
            "style": {
                "backgroundColor": "#F59E0B",
                "borderColor": "#FBBF24"
            }
        },
        {
            "id": "enrich",
