                    "name": "SharePoint",
                    "types": [
                        "policies",
                        "wikis"
                    ],
                    "priority": "high"
                },
                {
                    "name": "Confluence",
                    "types": [
                        "wikis"
                    ],
                    "priority": "high"
                },
                {
                    "name": "GitHub",
                    "types": [
                        "code"
                    ],
                    "priority": "medium"
                },
                {
