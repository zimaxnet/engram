{
  "title": "Gk (Graph Knowledge) — Tri-Search + Provenance",
  "subtitle": "Keyword + Vector + Gk fused by RRF; Fc + Environments make provenance inspectable",
  "version": "1.0",
  "theme": "dark",
  "layout": "flow",
  "diagram_type": "architecture",
  "legend": {
    "node_types": {
      "trigger": "Entry point",
      "ui": "User-facing surface",
      "api": "Backend API",
      "orchestrator": "Fusion / routing logic",
      "retriever": "Retriever layer",
      "store": "Storage system",
      "graph": "Graph knowledge system",
      "observability": "Transparency surface",
      "data": "Artifact / trace"
    },
    "edge_labels": {
      "Fc": "Function call (API endpoint)",
      "retrieves": "Retrieval call",
      "fuses": "Rank fusion",
      "persists": "Persistence/write path",
      "provenance": "Provenance link",
      "enriches": "Graph enrichment edges"
    }
  },
  "nodes": [
    {
      "id": "user",
      "label": "User",
      "type": "trigger",
      "icon": "user",
      "position": { "x": 120, "y": 80 },
      "description": "Human operator interacting with Engram UI"
    },
    {
      "id": "ui_graph",
      "label": "UI: /memory/graph (Gk)",
      "type": "ui",
      "icon": "network",
      "position": { "x": 320, "y": 60 },
      "description": "Graph visualization + filters + Fc + environments"
    },
    {
      "id": "ui_search",
      "label": "UI: /memory/search",
      "type": "ui",
      "icon": "search",
      "position": { "x": 320, "y": 140 },
      "description": "Tri-search result list with provenance intent"
    },
    {
      "id": "api_memory",
      "label": "API: Memory Router",
      "type": "api",
      "icon": "server",
      "position": { "x": 560, "y": 100 },
      "description": "GET /api/v1/memory/graph; POST /api/v1/memory/search; GET /api/v1/memory/environments"
    },
    {
      "id": "rrf",
      "label": "RRF Fusion",
      "type": "orchestrator",
      "icon": "git-branch",
      "position": { "x": 800, "y": 140 },
      "description": "Reciprocal Rank Fusion merges ranked outputs from K/V/G"
    },
    {
      "id": "kw",
      "label": "Keyword Retriever",
      "type": "retriever",
      "icon": "type",
      "position": { "x": 980, "y": 60 },
      "description": "Lexical retrieval over sessions + metadata"
    },
    {
      "id": "vx",
      "label": "Vector Retriever",
      "type": "retriever",
      "icon": "vector",
      "position": { "x": 980, "y": 140 },
      "description": "Semantic retrieval over embeddings (pgvector)"
    },
    {
      "id": "gk",
      "label": "Gk Retriever (Graph)",
      "type": "graph",
      "icon": "network",
      "position": { "x": 980, "y": 220 },
      "description": "Graph traversal over facts, episodes, topics, and provenance nodes"
    },
    {
      "id": "zep_sessions",
      "label": "Zep Sessions",
      "type": "store",
      "icon": "database",
      "position": { "x": 1180, "y": 60 },
      "description": "Episodes + message content + session metadata"
    },
    {
      "id": "pgvector",
      "label": "Postgres + pgvector",
      "type": "store",
      "icon": "database",
      "position": { "x": 1180, "y": 140 },
      "description": "Embeddings table used for semantic similarity"
    },
    {
      "id": "zep_graph",
      "label": "Zep Facts / Graph",
      "type": "store",
      "icon": "graph",
      "position": { "x": 1180, "y": 220 },
      "description": "Facts + metadata (and provider-side graph capabilities when available)"
    },
    {
      "id": "enrichment",
      "label": "Graph Enrichment",
      "type": "orchestrator",
      "icon": "spark",
      "position": { "x": 800, "y": 240 },
      "description": "Adds relationship types: Episode→Agent, Fact→Topic, Fact→Agent, Episode→Meta provenance"
    },
    {
      "id": "fc",
      "label": "Fc: Function Calls",
      "type": "observability",
      "icon": "code",
      "position": { "x": 560, "y": 260 },
      "description": "UI shows exact API calls + request timing"
    },
    {
      "id": "envs",
      "label": "Environments",
      "type": "observability",
      "icon": "globe",
      "position": { "x": 560, "y": 320 },
      "description": "UI shows active Zep URL + known env presets"
    },
    {
      "id": "trace",
      "label": "Provenance Traces",
      "type": "data",
      "icon": "tag",
      "position": { "x": 800, "y": 320 },
      "description": "Meta nodes: tenant_id/channel/source/filename; edge labels reflect provenance keys"
    }
  ],
