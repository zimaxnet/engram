      { "id": "g_ui", "label": "UI", "members": ["ui_graph", "ui_search"], "bounds": { "x": 260, "y": 30, "w": 220, "h": 170 } },
      { "id": "g_api", "label": "API", "members": ["api_memory"], "bounds": { "x": 510, "y": 60, "w": 220, "h": 110 } },
      { "id": "g_tri", "label": "Tri-Search", "members": ["rrf", "kw", "vx", "gk"], "bounds": { "x": 760, "y": 30, "w": 360, "h": 230 } },
